# Copy this file to .env and fill in your values before running docker compose up.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Generate with: iex -e ':crypto.strong_rand_bytes(32) |> Base.encode64() |> IO.puts()'
# IMPORTANT: Back this up securely — losing it makes all encrypted data unrecoverable.
VAULT_KEY=

# Your public hostname (used in URL generation). Use localhost for local dev.
PHX_HOST=localhost
