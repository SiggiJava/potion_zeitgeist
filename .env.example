# Optional settings for docker compose. Copy this file to .env next to
# docker-compose.yml and uncomment what you need. Without a .env file the app
# runs on http://localhost:4000 with keys generated on the first start.

# Host names or IP addresses people type in the browser to open the app,
# separated by commas (no http://, no port). The live pages only work from
# these hosts and from localhost.
#PHX_HOST=localhost
#PHX_HOST=zeit.example.com,192.168.1.20

# Port on this computer.
#APP_PORT=4000

# Set to true when the app is served over HTTPS by a reverse proxy: plain
# HTTP is then redirected to HTTPS.
#FORCE_SSL=false

# Image version: latest, a release such as 1.2.0, or sha-<commit>.
#APP_VERSION=latest

# Keys. Leave them unset to have them generated on the first start and kept
# in the app's data volume (back them up: see README). If you set them here,
# keep this file safe: losing VAULT_KEY makes the stored names and e-mail
# addresses unreadable. Never change VAULT_KEY of an existing installation.
# Generate with: openssl rand -base64 64 | tr -d '\n'   (SECRET_KEY_BASE)
#                openssl rand -base64 32                (VAULT_KEY)
#SECRET_KEY_BASE=
#VAULT_KEY=

# Database password, used when the database volume is created for the first
# time. Letters and digits only. Changing it later does not change the
# password of an existing database.
#POSTGRES_PASSWORD=postgres
