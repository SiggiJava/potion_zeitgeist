<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <%!-- The title is the default file name when saving as PDF. --%>
    <title>{assigns[:page_title] || "Rechnung"}</title>
    <%!-- This page loads neither app.css nor app.js: the invoice styles come
         inline from InvoiceComponents, so an outdated asset build cannot
         change the printed invoice. The fonts are files in priv/static. --%>
    <link
      rel="preload"
      href="/fonts/inter/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/inter-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {PotionZeitgeistWeb.InvoiceComponents.invoice_style()}
  </head>
  <body class="inv-print-page">
    {@inner_content}
  </body>
</html>
