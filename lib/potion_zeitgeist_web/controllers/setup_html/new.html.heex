<div class="min-h-screen flex items-center justify-center bg-base-200">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-primary">Potion Zeitgeist</h1>
        <p class="text-base-content/60 mt-1">First-time Setup</p>
      </div>

      <h2 class="card-title text-xl justify-center mb-2">Create Administrator Account</h2>
      <p class="text-sm text-base-content/60 text-center mb-6">
        No administrators found. Set up the first admin account to get started.
      </p>

      <.form :let={f} for={@changeset} action={~p"/setup"} method="post">
        <div class="form-control mb-4">
          <label class="label" for={f[:name].id}>
            <span class="label-text font-medium">Full Name</span>
          </label>
          <input
            type="text"
            id={f[:name].id}
            name={f[:name].name}
            value={f[:name].value}
            class={"input input-bordered w-full #{if f[:name].errors != [], do: "input-error"}"}
            placeholder="Jane Doe"
            required
          />
          <%= if error = List.first(f[:name].errors) do %>
            <label class="label">
              <span class="label-text-alt text-error">{translate_error(error)}</span>
            </label>
          <% end %>
        </div>

        <div class="form-control mb-4">
          <label class="label" for={f[:email].id}>
            <span class="label-text font-medium">Email</span>
          </label>
          <input
            type="email"
            id={f[:email].id}
            name={f[:email].name}
            value={f[:email].value}
            class={"input input-bordered w-full #{if f[:email].errors != [], do: "input-error"}"}
            placeholder="admin@example.com"
            required
          />
          <%= if error = List.first(f[:email].errors) do %>
            <label class="label">
              <span class="label-text-alt text-error">{translate_error(error)}</span>
            </label>
          <% end %>
        </div>

        <div class="form-control mb-6">
          <label class="label" for={f[:password].id}>
            <span class="label-text font-medium">Password</span>
          </label>
          <input
            type="password"
            id={f[:password].id}
            name={f[:password].name}
            class={"input input-bordered w-full #{if f[:password].errors != [], do: "input-error"}"}
            placeholder="Min. 8 characters"
            required
          />
          <%= if error = List.first(f[:password].errors) do %>
            <label class="label">
              <span class="label-text-alt text-error">{translate_error(error)}</span>
            </label>
          <% end %>
        </div>

        <button type="submit" class="btn btn-primary w-full">
          Create Admin Account
        </button>
      </.form>
    </div>
  </div>
</div>
