<div class="min-h-screen flex items-center justify-center bg-base-200">
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body">
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-primary">Potion Zeitgeist</h1>
        <p class="text-base-content/60 mt-1">Time Tracking</p>
      </div>

      <h2 class="card-title text-xl justify-center mb-4">Sign in to your account</h2>

      <%= if msg = Phoenix.Flash.get(@flash, :info) do %>
        <div class="alert alert-success mb-4">
          <.icon name="hero-check-circle" class="size-5" />
          <span>{msg}</span>
        </div>
      <% end %>

      <%= if @error_message do %>
        <div class="alert alert-error mb-4">
          <.icon name="hero-exclamation-circle" class="size-5" />
          <span>{@error_message}</span>
        </div>
      <% end %>

      <form action={~p"/login"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

        <div class="form-control mb-4">
          <label class="label" for="user_email">
            <span class="label-text font-medium">Email</span>
          </label>
          <input
            type="email"
            id="user_email"
            name="user[email]"
            class="input input-bordered w-full"
            placeholder="you@example.com"
            required
            autofocus
          />
        </div>

        <div class="form-control mb-6">
          <label class="label" for="user_password">
            <span class="label-text font-medium">Password</span>
          </label>
          <input
            type="password"
            id="user_password"
            name="user[password]"
            class="input input-bordered w-full"
            placeholder="••••••••"
            required
          />
        </div>

        <button type="submit" class="btn btn-primary w-full">
          Sign in
        </button>
      </form>
    </div>
  </div>
</div>
