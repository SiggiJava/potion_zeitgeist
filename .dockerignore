# Keeps the Docker build context small and free of local or secret files.
# The image builds its own dependencies, assets and release.

.git
.github
.elixir_ls
.env
.env.*
*.md
Dockerfile
.dockerignore
docker-compose*.yml

# Mix artifacts and dependencies
/_build/
/deps/
*.ez
erl_crash.dump

# Development and test files
/cover/
/doc/
/test/
/tmp/

# Built inside the image
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json
